rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || (!isSignedIn() && isValidId(userId));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users collection storing student profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Subcollection: quizSubmissions
      match /quizSubmissions/{submissionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(submissionId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: notes
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(noteId);
        allow delete: if isOwner(userId);
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
